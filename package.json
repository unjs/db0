{
  "name": "db0",
  "version": "0.4.0",
  "description": "Lightweight SQL Connector",
  "repository": "unjs/db0",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tracing": {
      "types": "./dist/tracing.d.mts",
      "default": "./dist/tracing.mjs"
    },
    "./connectors/*": {
      "types": "./dist/connectors/*.d.mts",
      "default": "./dist/connectors/*.mjs"
    },
    "./integrations/*": {
      "types": "./dist/integrations/*/index.d.mts",
      "default": "./dist/integrations/*/index.mjs"
    },
    "./connectors/libsql/*": {
      "types": "./dist/connectors/libsql/*.d.mts",
      "default": "./dist/connectors/libsql/*.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm gen-connectors && pnpm gen-capabilities && obuild",
    "gen-connectors": "jiti scripts/gen-connectors.ts",
    "gen-capabilities": "jiti scripts/gen-capabilities-docs.ts && automd --dir docs --input 1.guide/2.capabilities.md",
    "db0": "pnpm jiti src/cli",
    "dev": "vitest",
    "lint": "prettier -c src test scripts",
    "fmt": "prettier -w src test scripts",
    "prepack": "pnpm build",
    "prisma:generate": "prisma generate --schema test/integrations/prisma/sqlite/schema.prisma && prisma generate --schema test/integrations/prisma/postgresql/schema.prisma",
    "release": "pnpm test && changelogen --release --push && pnpm publish",
    "test": "pnpm lint && pnpm test:types && pnpm prisma:generate && vitest run --coverage && pnpm test:bun",
    "test:bun": "bun test ./test/connectors/bun-test.ts",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@electric-sql/pglite": "^0.5.5",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@planetscale/database": "^1.20.1",
    "@prisma/client": "^7.2.0",
    "@prisma/driver-adapter-utils": "^7.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "automd": "^0.4.3",
    "better-sqlite3": "^13.0.3",
    "changelogen": "^0.6.2",
    "db0": "^0.3.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "eslint-config-unjs": "^0.6.2",
    "jiti": "^2.7.0",
    "kysely": "^0.29.5",
    "mlly": "^1.8.2",
    "mysql2": "^3.23.3",
    "obuild": "^0.4.38",
    "pathe": "^2.0.3",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prisma": "^7.2.0",
    "scule": "^1.3.0",
    "sqlite3": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}
