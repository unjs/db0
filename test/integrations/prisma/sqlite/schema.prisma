datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "./client"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  active    Boolean  @default(true)
  score     Float?
  data      Bytes?
  createdAt DateTime @default(now())

  @@map("users")
}
